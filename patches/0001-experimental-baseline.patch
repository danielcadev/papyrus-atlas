 #include <stdlib.h>
 #include <string.h>
 #include "../common/pitch_table.h"
+#include "../common/closest_tri.h"
 
 static double now_sec(void) { return ves_clock_sec(); }
 static double elapsed_since(double t0) { return now_sec() - t0; }
+
+/* Size alone cannot establish that a split sibling is spatially subsumed.
+ * Require each candidate triangle to lie within eps of ONE owner triangle:
+ * distance to a convex triangle is convex, so covering all three vertices
+ * also bounds every point of their convex hull. This is deliberately more
+ * conservative than independent nearest-vertex samples. On budget exhaustion
+ * coverage is unproven and the source chart is retained. */
+static int pipeline_component_covered(const ComponentMesh *candidate,
+                                       const ComponentMesh *owner,
+                                       double eps)
+{
+    size_t checks = 0;
+    double eps2 = eps * eps;
+    for (size_t fi = 0; fi < candidate->nf; fi++) {
+        double p[3][3];
+        for (int i = 0; i < 3; i++)
+            for (int d = 0; d < 3; d++)
+                p[i][d] = candidate->verts[(size_t)candidate->faces[fi*3+i]*3+d];
+        int covered = 0;
+        for (size_t fj = 0; fj < owner->nf; fj++) {
+            if (++checks > 1000000) return 0;
+            double q[3][3];
+            for (int i = 0; i < 3; i++)
+                for (int d = 0; d < 3; d++)
+                    q[i][d] = owner->verts[(size_t)owner->faces[fj*3+i]*3+d];
+            int possible = 1;
+            for (int d = 0; d < 3; d++) {
+                double mn = fmin(q[0][d], fmin(q[1][d], q[2][d])) - eps;
+                double mx = fmax(q[0][d], fmax(q[1][d], q[2][d])) + eps;
+                for (int i = 0; i < 3; i++)
+                    if (p[i][d] < mn || p[i][d] > mx) possible = 0;
+            }
+            if (!possible) continue;
+            covered = 1;
+            for (int i = 0; i < 3; i++)
+                if (!(ClosestTri_dist2(p[i], q[0], q[1], q[2]) <= eps2)) {
+                    covered = 0;
+                    break;
+                }
+            if (covered) break;
+        }
+        if (!covered) return 0;
+    }
+    return candidate->nf > 0;
+}
 
